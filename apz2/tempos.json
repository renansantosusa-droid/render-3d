s","t":59.749},{"w":"outros","t":60.377},{"w":"passos","t":60.768},{"w":"Mais","t":61.44},{"w":"rápidos","t":61.84},{"w":"Muitos","t":62.52},{"w":"Indo","t":63.488},{"w":"atrás","t":63.76},{"w":"da","t":64.107},{"w":"luz","t":64.22},{"w":"dela","t":64.464}]},{"n":9,"ini":64.95,"fim":71.6,"texto":"Lá na frente, o celular dela cai no chão. A luz fica apontada pro teto. E ninguém volta pra buscar.","palavras":[{"w":"Lá","t":64.95},{"w":"na","t":65.137},{"w":"frente","t":65.236},{"w":"o","t":65.57},{"w":"celular","t":65.64},{"w":"dela","t":66.038},{"w":"cai","t":66.27},{"w":"no","t":66.443},{"w":"chão","t":66.603},{"w":"A","t":67.07},{"w":"luz","t":67.35},{"w":"fica","t":67.622},{"w":"apontada","t":67.803},{"w":"pro","t":68.37},{"w":"teto","t":68.59},{"w":"E","t":69.47},{"w":"ninguém","t":69.87},{"w":"volta","t":70.377},{"w":"pra","t":70.75},{"w":"buscar","t":70.927}]},{"n":10,"ini":71.75,"fim":81.67,"texto":"No passo seiscentos, o Davi pisa no trilho do meio. A Jéssica puxa ele pelo braço: sai daí! Ela nem sabe por quê. Só sabe que não gostou daquele trilho.","palavras":[{"w":"No","t":71.75},{"w":"passo","t":71.878},{"w":"seiscentos","t":72.31},{"w":"o","t":72.99},{"w":"Davi","t":73.07},{"w":"pisa","t":73.35},{"w":"no","t":73.723},{"w":"trilho","t":73.883},{"w":"do","t":74.177},{"w":"meio","t":74.294},{"w":"A","t":74.83},{"w":"Jéssica","t":75.07},{"w":"puxa","t":75.51},{"w":"ele","t":75.87},{"w":"pelo","t":76.022},{"w":"braço","t":76.23},{"w":"sai","t":76.98},{"w":"daí","t":77.27},{"w":"Ela","t":77.883},{"w":"nem","t":78.27},{"w":"sabe","t":78.47},{"w":"por","t":78.83},{"w":"quê","t":79.003},{"w":"Só","t":79.61},{"w":"sabe","t":79.942},{"w":"que","t":80.11},{"w":"não","t":80.29},{"w":"gostou","t":80.534},{"w":"daquele","t":80.923},{"w":"trilho","t":81.27}]},{"n":11,"ini":81.82,"fim":88.06,"texto":"Passo mil cento e cinquenta. Faltam cinquenta metros. Lá na frente, dá pra ver a boca do túnel.","palavras":[{"w":"Passo","t":81.82},{"w":"mil","t":82.12},{"w":"cento","t":82.364},{"w":"e","t":82.68},{"w":"cinquenta","t":82.74},{"w":"Faltam","t":83.46},{"w":"cinquenta","t":84.04},{"w":"metros","t":84.54},{"w":"Lá","t":85.38},{"w":"na","t":85.687},{"w":"frente","t":85.786},{"w":"dá","t":86.353},{"w":"pra","t":86.5},{"w":"ver","t":86.66},{"w":"a","t":86.86},{"w":"boca","t":86.988},{"w":"do","t":87.207},{"w":"túnel","t":87.34}]},{"n":12,"ini":88.21,"fim":100.05,"texto":"E aí a luz volta. Todas as lâmpadas do túnel acendem de uma vez. O trilho do meio dá um estalo. É o gerador de emergência do metrô. Quem estava pisando nele naquela hora não levantou mais.","palavras":[{"w":"E","t":88.21},{"w":"aí","t":88.33},{"w":"a","t":88.49},{"w":"luz","t":88.59},{"w":"volta","t":88.837},{"w":"Todas","t":89.62},{"w":"as","t":90.103},{"w":"lâmpadas","t":90.25},{"w":"do","t":90.663},{"w":"túnel","t":90.85},{"w":"acendem","t":91.223},{"w":"de","t":91.623},{"w":"uma","t":91.75},{"w":"vez","t":91.91},{"w":"O","t":92.61},{"w":"trilho","t":92.903},{"w":"do","t":93.223},{"w":"meio","t":93.378},{"w":"dá","t":93.623},{"w":"um","t":93.757},{"w":"estalo","t":93.87},{"w":"É","t":94.57},{"w":"o","t":94.83},{"w":"gerador","t":94.92},{"w":"de","t":95.277},{"w":"emergência","t":95.383},{"w":"do","t":95.917},{"w":"metrô","t":96.01},{"w":"Quem","t":96.637},{"w":"estava","t":97.136},{"w":"pisando","t":97.47},{"w":"nele","t":97.89},{"w":"naquela","t":98.183},{"w":"hora","t":98.594},{"w":"não","t":98.91},{"w":"levantou","t":99.13},{"w":"mais","t":99.57}]},{"n":13,"ini":100.2,"fim":103.56,"texto":"Regra número dois: trilho parado não é trilho morto.","palavras":[{"w":"Regra","t":100.2},{"w":"número","t":100.486},{"w":"dois","t":100.808},{"w":"trilho","t":101.373},{"w":"parado","t":101.84},{"w":"não","t":102.3},{"w":"é","t":102.68},{"w":"trilho","t":102.813},{"w":"morto","t":103.144}]},{"n":14,"ini":103.71,"fim":114.11,"texto":"A luz fica acesa trinta segundos. Tempo suficiente pra eles verem a plataforma da Sé. Ela tá cheia. Centenas. Parados. Virados pro túnel.","palavras":[{"w":"A","t":103.71},{"w":"luz","t":103.85},{"w":"fica","t":104.078},{"w":"acesa","t":104.31},{"w":"trinta","t":104.723},{"w":"segundos","t":105.141},{"w":"Tempo","t":106.083},{"w":"suficiente","t":106.39},{"w":"pra","t":106.95},{"w":"eles","t":107.118},{"w":"verem","t":107.35},{"w":"a","t":107.59},{"w":"plataforma","t":107.688},{"w":"da","t":108.297},{"w":"Sé","t":108.457},{"w":"Ela","t":109.097},{"w":"tá","t":109.47},{"w":"cheia","t":109.63},{"w":"Centenas","t":110.51},{"w":"Parados","t":111.57},{"w":"Virados","t":112.75},{"w":"pro","t":113.29},{"w":"túnel","t":113.55}]},{"n":15,"ini":114.26,"fim":120.1,"texto":"Eles não estão esperando o trem. Estão esperando quem vem de dentro dele. E a luz apaga.","palavras":[{"w":"Eles","t":114.26},{"w":"não","t":114.46},{"w":"estão","t":114.633},{"w":"esperando","t":114.953},{"w":"o","t":115.46},{"w":"trem","t":115.588},{"w":"Estão","t":116.13},{"w":"esperando","t":116.393},{"w":"quem","t":116.852},{"w":"vem","t":117.04},{"w":"de","t":117.273},{"w":"dentro","t":117.437},{"w":"dele","t":117.86},{"w":"E","t":118.66},{"w":"a","t":118.86},{"w":"luz","t":118.98},{"w":"apaga","t":119.3}]}]},"fala":103.719,"antesEnxuga":{"fala":111.75925925925925,"cortes":67}}