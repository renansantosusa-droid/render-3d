us","t":92.54},{"w":"com","t":92.92},{"w":"a","t":93.02},{"w":"porta","t":93.113},{"w":"aberta","t":93.433},{"w":"Carros","t":94.16},{"w":"com","t":94.52},{"w":"o","t":94.66},{"w":"pisca-alerta","t":94.78},{"w":"ligado","t":95.5},{"w":"E","t":96.22},{"w":"nenhuma","t":96.3},{"w":"luz","t":96.82},{"w":"acesa","t":97.14},{"w":"na","t":97.487},{"w":"cidade","t":97.597},{"w":"inteira","t":98.004}]},{"n":16,"ini":98.89,"fim":105.53,"texto":"Mas eles não estão sozinhos na praça. Do outro lado, cinco lanternas acendem. E vêm na direção deles.","palavras":[{"w":"Mas","t":98.89},{"w":"eles","t":99.162},{"w":"não","t":99.33},{"w":"estão","t":99.503},{"w":"sozinhos","t":99.823},{"w":"na","t":100.303},{"w":"praça","t":100.45},{"w":"Do","t":101.237},{"w":"outro","t":101.33},{"w":"lado","t":101.594},{"w":"cinco","t":102.223},{"w":"lanternas","t":102.56},{"w":"acendem","t":103.21},{"w":"E","t":104.05},{"w":"vêm","t":104.17},{"w":"na","t":104.437},{"w":"direção","t":104.538},{"w":"deles","t":105.05}]},{"n":17,"ini":105.68,"fim":111.68,"texto":"Aqui termina a parte um. Comenta parte dois se você quer saber quem tá segurando essas lanternas.","palavras":[{"w":"Aqui","t":105.68},{"w":"termina","t":105.977},{"w":"a","t":106.38},{"w":"parte","t":106.453},{"w":"um","t":106.8},{"w":"Comenta","t":107.36},{"w":"parte","t":107.893},{"w":"dois","t":108.224},{"w":"se","t":108.56},{"w":"você","t":108.768},{"w":"quer","t":108.992},{"w":"saber","t":109.187},{"w":"quem","t":109.584},{"w":"tá","t":109.92},{"w":"segurando","t":110.12},{"w":"essas","t":110.6},{"w":"lanternas","t":110.86}]}]},"fala":96.763,"antesEnxuga":{"fala":103.96296296296296,"cortes":60}}